━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[/CENTER]


[SIZE=4][COLOR=#e74c3c]■[/COLOR] [B]Commands & Permissions[/B][/SIZE]

[SIZE=3][COLOR=#2ecc71]Player Commands[/COLOR][/SIZE]
[CODE]
/vote                    — Opens the vote GUI
/vote help               — Shows player command help
/vote sites              — Lists all vote sites with clickable links
/vote stats [player]     — View vote statistics
/vote top [count]        — View the all-time leaderboard (max 50)
/vote rewards            — Opens the rewards/economy menu
/vote shop               — Opens the vote-token shop (Premium)
/vote freeze             — Buy a Streak Freeze with vote points
/vote gift <player>      — Gift a streak day to a player (or 'random')
[/CODE]
Permission: [ICODE]jexvote.command.vote[/ICODE]
Aliases: [ICODE]/v[/ICODE]

[SIZE=3][COLOR=#e74c3c]Admin Commands[/COLOR][/SIZE]
[CODE]
/jexvote                 — Shows admin help
/jexvote info            — Shows edition, version, site count, Votifier port
/jexvote reload          — Hot-reloads config.yml, rewards.yml, sites.yml
/jexvote reset <player>  — Resets all vote data for a player
/jexvote resetmonthly    — Resets monthly counts for ALL players
/jexvote fakevote <player> [service]  — Simulates a vote for testing
/jexvote key             — Prints Votifier public key, PEM, port and v2 token (click-to-copy)
/jexvote setstreak <player> <value>   — Set a player's vote streak
/jexvote debug-services  — Diagnose vote service-name mismatches
[/CODE]
Aliases: [ICODE]/jv[/ICODE]

[SIZE=3]Permission Nodes[/SIZE]
[CODE]
jexvote.command.vote              — Access to /vote and all subcommands
jexvote.command.admin             — Access to /jexvote base and info
jexvote.command.admin.reload      — Reload configuration files
jexvote.command.admin.reset       — Reset player data and monthly counts
jexvote.command.admin.fakevote    — Simulate test votes
jexvote.freeze.max.<n>            — Raise the Streak Freeze owned cap to <n>
jexvote.gift.daily.<n>            — Raise the daily gift limit to <n>
[/CODE]


[CENTER]
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[/CENTER]


[SIZE=4][COLOR=#1abc9c]■[/COLOR] [B]Configuration Reference[/B][/SIZE]

[SPOILER="config.yml — Full Reference"]
[CODE=YAML]
# ── Votifier Server ──
votifier:
  host: ''              # Bind address (empty = all interfaces)
  port: 8192            # Listener port
  token: ''             # HMAC token (auto-generated on first run)

# ── Broadcast ──
broadcast:
  mode: 'all'           # all | others | none
  cooldown: 0           # Seconds between broadcasts (0 = every vote)

# ── Private Message ──
private-message:
  enabled: true         # Send thank-you message to the voter

# ── Offline Queue ──
offline-vote-queue: true  # Deliver rewards when offline voters log in

# ── Feature Toggles ──
features:
  streaks: true
  shop: true
  leaderboard: true
  effects: true

# ── Streaks ──
streak:
  timeout-hours: 36     # Hours before a streak breaks
  claim-mode: 'auto'    # auto | manual
  freeze:
    enabled: true
    free-amount: 1      # Free freezes granted on first vote
    cost-points: 5      # Vote points per purchased freeze
    default-max: 3      # Owned cap (raise per rank with jexvote.freeze.max.<n>)
    duration-hours: 24  # Grace one freeze covers

  bonus-commands:
    7:
      - "give {player} diamond 3"
    30:
      - "broadcast &6{player} &7hit a &630-day &7vote streak!"

# ── Vote Gifting ──
vote-gift:
  enabled: true
  daily-limit: 1        # Raise per rank with jexvote.gift.daily.<n>
  require-vote-today: true
  timezone: 'UTC'

# ── Vote Party (Premium) ──
vote-party:
  enabled: true
  target: 100

# ── Weekend Multiplier (Premium) ──
multipliers:
  weekend:
    enabled: false
    factor: 2.0
    days: [SATURDAY, SUNDAY]
    timezone: 'UTC'

# ── REST API ──
rest-api:
  enabled: false
  port: 8193
  cors-origin: ''
  rate-limit: 60        # Requests per minute per IP

# ── Record Retention ──
records:
  retention-days: 90    # Days to keep vote records (0 = forever)
[/CODE]
[/SPOILER]


[CENTER]
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[/CENTER]


[SIZE=4][COLOR=#f39c12]■[/COLOR] [B]Streak System[/B][/SIZE]

Streaks track how many days in a row a player has voted. The timeout is configurable — by default, a player has 36 hours between votes before the streak resets. This gives some buffer beyond a strict 24-hour window. Streak Freezes extend that buffer automatically when a day is missed.

Streak milestones can trigger two things independently:
[LIST]
[*][B]Bonus commands[/B] — Defined in [ICODE]config.yml[/ICODE] under [ICODE]streak.bonus-commands[/ICODE]. Quick and simple for running commands.
[*][B]Streak rewards[/B] — Defined in [ICODE]rewards.yml[/ICODE] under [ICODE]streak-rewards[/ICODE]. Uses the full reward type system (items, currency, choice menus, etc.).
[/LIST]

Both fire at the same milestone if configured. Set up whichever fits your use case — or both.

The streak progress is shown in every GUI: the overview displays a progress bar toward the next milestone, and the dedicated streak view breaks down every milestone with achieved/upcoming/locked status.


[CENTER]
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[/CENTER]


[SIZE=4][COLOR=#2c3e50]■[/COLOR] [B]Votifier Protocol[/B][/SIZE]

JExVote includes a fully self-contained Votifier server. There is no need to install NuVotifier or any third-party listener.

[B]Supported protocols:[/B]
[LIST]
[*][B]Votifier v1[/B] — 256-byte RSA-encrypted vote block. Legacy support for older vote sites.
[*][B]NuVotifier v2[/B] — JSON payload with HMAC-SHA256 signature verification and challenge-response. Used by most modern vote sites.
[/LIST]

JExVote auto-detects the protocol version per connection. The RSA keypair is generated on first launch and stored in [ICODE]plugins/JExVote/rsa/[/ICODE]. The HMAC token is written to [ICODE]config.yml[/ICODE].

If a vote site asks for your public key, you will find it at [ICODE]plugins/JExVote/rsa/public.key[/ICODE] (Base64-encoded). Alternatively, use [ICODE]/jexvote key[/ICODE] in-game to display the key, port, and token with click-to-copy.


[CENTER]
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[/CENTER]


[SIZE=4][COLOR=#16a085]■[/COLOR] [B]Language & Localization[/B][/SIZE]

JExVote ships with translations for:
[LIST]
[*][ICODE]en_US[/ICODE] — English
[*][ICODE]de_DE[/ICODE] — German
[*][ICODE]cs_CZ[/ICODE] — Czech
[*][ICODE]sk_SK[/ICODE] — Slovak
[/LIST]

The language is auto-detected per player based on their client locale. Item names in the rewards menu use the player's own client language. To force a specific language for the entire server, create a [ICODE]translations/config.yml[/ICODE] in the plugin folder:

[CODE=YAML]
# Force all players to see this locale regardless of client setting.
# Leave empty to use auto-detection.
force-locale: 'de_DE'
[/CODE]

You can add custom translations by placing a [ICODE]<locale>.yml[/ICODE] file in the [ICODE]translations/[/ICODE] folder. Missing keys fall back to the default English translation.


[CENTER]
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[/CENTER]


[SIZE=4][COLOR=#c0392b]■[/COLOR] [B]Dependencies[/B][/SIZE]

[B]Required:[/B]
[LIST]
[*]Paper 1.20.4+ (or Spigot / Folia)
[*]Java 21+
[/LIST]

[B]Optional (soft dependencies):[/B]
[LIST]
[*][B]JExEconomy[/B] — Enables the [ICODE]currency[/ICODE] reward type
[*][B]LuckPerms[/B] — Enables the [ICODE]permission[/ICODE] reward type (timed permissions, server-specific)
[*][B]PlaceholderAPI[/B] — Exposes vote placeholders for use in scoreboards, tab lists, etc.
[*][B]Vault[/B] — Economy fallback if JExEconomy is not installed
[*][B]Floodgate[/B] — Enables native Bedrock Edition forms for Geyser/Floodgate players
[/LIST]


